# ============================================================================
# 杭博门业经营分析系统 · Git 忽略规则
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 环境变量（含数据库密码，绝不入库）----
.env
.env.local
.env.production
*.env

# ---- 本地 MySQL 实例（含数据文件，体积大且可重建）----
.mysql/

# ---- Django ----
*.log
logs/
db.sqlite3
db.sqlite3-journal
/staticfiles/
/mediafiles/
/media/

# ---- 模型产物（可重训，不入库）----
artifacts/
*.joblib
*.pkl

# ---- 测试与覆盖率 ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- 临时导出 ----
*.tmp
~$*.docx
~$*.xlsx
docs/_pipinstall.log
docs/_pipinstall.err

# ---- 交付快照（整份副本，不进版本库）----
handoff/

# ---- 由脚本生成的 Word 文档（源文件是 docs/*.md，二进制不入库）----
reports/*.docx

# ---- 内部工作记录与调研笔记（不属于作品本身）----
docs/PROGRESS.md
docs/github_research.md

# ---- 旧版 Streamlit 原型的截图（仅作改造前后对照）----
outputs/screenshots/dashboard_总览.png
