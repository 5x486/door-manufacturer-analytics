# ============================================================================
# 环境变量样例 —— 复制为 .env 后按需修改
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会进版本库
# ============================================================================

# ---- Django 基础 ----
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-production-please-use-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- 数据库（MySQL 8）----
DB_ENGINE=mysql
DB_NAME=door_analysis
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3307

# ---- 数据口径基准日（全项目唯一来源，取代脚本里三处硬编码）----
DATA_AS_OF=2026-08-09

# ---- 业务目标与预算（用于「目标 vs 实际」）----
SALES_TARGET_2023=8000000
SALES_TARGET_2024=16000000
SALES_TARGET_2025=24000000
SALES_TARGET_2026=28000000

# ---- 缓存（留空则用本地内存缓存）----
REDIS_URL=

# ---- 分析参数 ----
PAGE_SIZE=50
ANALYTICS_CACHE_TTL=600
